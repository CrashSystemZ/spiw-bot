# Telegram: token from @BotFather, app credentials from https://my.telegram.org
BOT_TOKEN=
TG_API_ID=
TG_API_HASH=

# API key of our own cobalt instance, the same UUID as in keys.json
COBALT_AUTHORIZATION=Api-Key 00000000-0000-4000-8000-000000000000

# Other cobalt instances to fall back to, tried in order after our own.
# Only instances whose owner allowed it; add the key they gave you after a `|`.
# COBALT_EXTRA_ENDPOINTS=https://cobalt.example.org|Api-Key <uuid>,https://open.example.net

# The server's public IP, so the jail also blocks the host's own address
HOST_PUBLIC_IP=

# Optional, defaults shown
# LOG_LEVEL=info
# INLINE_RESOLVE_TIMEOUT_MS=5000
# COBALT_REQUEST_TIMEOUT_MS=8000
# REHYDRATE_TTL_SECONDS=432000
# MAX_CONCURRENT_JOBS=32
# MAX_FETCHES_PER_JOB=4
# MEDIA_BUFFER_BUDGET_BYTES=2147483648
# MAX_MEDIA_ITEM_BYTES=2147483648
